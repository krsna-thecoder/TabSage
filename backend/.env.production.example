# TabSage backend — PRODUCTION (AWS Lightsail Containers) NON-SECRET settings.
#
# These are NOT a committed .env. On Lightsail they live in the container
# deployment's `environment` block (see lightsail/containers.json). This file
# just documents what to set and sane values.
# ⚠️ NEVER put a provider key here — BYOK: the user's key arrives per request in
#    the X-Provider-Key header and is used transiently, never stored.

# Environment name — "prod" disables dev-only behavior.
ENV=prod

# CORS allowlist (comma-separated, NEVER "*"). MUST include the extension origin
# plus any web origins that call the API. Get the extension id from
# chrome://extensions after loading/publishing the extension.
ALLOWED_ORIGINS=chrome-extension://REPLACE_WITH_EXTENSION_ID

# Optional CORS regex (in addition to ALLOWED_ORIGINS). Default allows ANY
# browser-extension origin, so the same backend serves your unpacked dev build,
# the Edge listing, and the Chrome listing without updating per-store ids.
# Leave this as-is and you can ignore the REPLACE line above. Set to "" to
# require exact origins only.
ALLOWED_ORIGIN_REGEX=^chrome-extension://[a-z]{32}$

# Lightsail fronts the container with its own HTTPS load balancer, so trust the
# forwarded client IP — otherwise the rate limiter's IP fallback and the access
# log would record the proxy, not the real caller.
FORWARDED_ALLOW_IPS=*

# In-memory store + rate limiter are per-process → keep ONE worker.
WEB_CONCURRENCY=1

# Port the container listens on. The image defaults to 8000; the Lightsail
# public endpoint (lightsail/public-endpoint.json) must target the same port.
PORT=8000

# Ephemeral session store
SESSION_TTL_SECONDS=3600
PURGE_INTERVAL_SECONDS=300

# Abuse limits
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
MAX_INGESTS_PER_WINDOW=30

# Payload caps
MAX_TEXT_CHARS=200000
MAX_CHUNKS_PER_INGEST=400
MAX_SOURCES_PER_SESSION=20
MAX_QUESTION_CHARS=2000

# Logging (access log never includes headers or bodies → no key/page text)
LOG_LEVEL=INFO
