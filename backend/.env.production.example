# TabSage backend — PRODUCTION (Render) reference for NON-SECRET settings.
#
# You do NOT commit a real .env to Render. These keys are set in the Render
# dashboard (or declared in ../render.yaml). This file just documents what to
# set and sane values. ⚠️ NEVER put a provider key here — BYOK: the user's key
# arrives per request in the X-Provider-Key header and is used transiently.

# Environment name — "prod" disables dev-only behavior.
ENV=prod

# CORS allowlist (comma-separated, NEVER "*"). MUST include the extension origin
# plus any web origins that call the API. Get the extension id from
# chrome://extensions after loading/publishing the extension.
ALLOWED_ORIGINS=chrome-extension://REPLACE_WITH_EXTENSION_ID

# Render terminates TLS at its proxy; trust its forwarded client IP so the rate
# limiter's IP fallback and the access log record the real caller, not the proxy.
FORWARDED_ALLOW_IPS=*

# In-memory store + rate limiter are per-process → keep ONE worker.
WEB_CONCURRENCY=1

# Ephemeral session store
SESSION_TTL_SECONDS=3600
PURGE_INTERVAL_SECONDS=300

# Abuse limits
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
MAX_INGESTS_PER_WINDOW=30

# Payload caps
MAX_TEXT_CHARS=200000
MAX_CHUNKS_PER_INGEST=400
MAX_SOURCES_PER_SESSION=20
MAX_QUESTION_CHARS=2000

# Logging (access log never includes headers or bodies → no key/page text)
LOG_LEVEL=INFO

# NOTE: PORT is injected by Render automatically; do not hardcode it here.
