# TabSage backend — NON-SECRET settings only.
# ⚠️ NEVER put a provider key here. BYOK: the user's key arrives per request
#    via the X-Provider-Key header and is used transiently, never stored.

# Environment name: "dev" | "prod"
ENV=dev

# CORS: comma-separated allowed origins (NOT "*").
# In dev, allow localhost; add your extension origin chrome-extension://<id> once known.
ALLOWED_ORIGINS=http://localhost,http://localhost:8000

# Server bind (local dev)
HOST=127.0.0.1
PORT=8000

# Session store TTL in seconds (ephemeral store default; e.g. 3600 = 1 hour)
SESSION_TTL_SECONDS=3600

# Payload / volume caps (Section 10 abuse limits)
MAX_TEXT_CHARS=200000
MAX_CHUNKS_PER_INGEST=400
MAX_SOURCES_PER_SESSION=20
MAX_QUESTION_CHARS=2000
