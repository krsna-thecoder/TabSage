# TabSage backend — NON-SECRET settings only.
# ⚠️ NEVER put a provider key here. BYOK: the user's key arrives per request
#    via the X-Provider-Key header and is used transiently, never stored.

# Environment name: "dev" | "prod"
ENV=dev

# CORS: comma-separated allowed origins (NOT "*").
# In dev, allow localhost; add your extension origin chrome-extension://<id> once known.
ALLOWED_ORIGINS=http://localhost,http://localhost:8000

# Optional CORS regex (in addition to ALLOWED_ORIGINS). Default allows any
# browser-extension origin so you don't chase per-store extension ids. Set to
# empty to disable. CORS is not a security boundary (requests still need the
# user's key + are rate-limited).
ALLOWED_ORIGIN_REGEX=^chrome-extension://[a-z]{32}$

# Server bind (local dev)
HOST=127.0.0.1
PORT=8000

# Session store TTL in seconds (ephemeral store default; e.g. 3600 = 1 hour)
SESSION_TTL_SECONDS=3600

# How often the background sweeper drops idle sessions (seconds)
PURGE_INTERVAL_SECONDS=300

# Payload / volume caps (Section 10 abuse limits)
MAX_TEXT_CHARS=200000
MAX_CHUNKS_PER_INGEST=400
MAX_SOURCES_PER_SESSION=20
MAX_QUESTION_CHARS=2000

# Abuse protection / rate limiting (per client = X-Client-Token, else IP)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
MAX_INGESTS_PER_WINDOW=30

# Logging level (DEBUG|INFO|WARNING|ERROR). Access log never includes
# request headers or bodies (so the key and page text are never logged).
LOG_LEVEL=INFO
